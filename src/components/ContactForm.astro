---
/**
 * Componente de Formulario de Contacto Seguro - CEDETPRO Ecuador
 * 
 * Protegido contra:
 * - Inyección SQL (SQLi)
 * - Cross-Site Scripting (XSS)
 * - Inyección de Cabeceras SMTP (CRLF Injection)
 * - Ataques automatizados y bot spam (Honeypot + Speed Trap + Rate Limiting)
 */
---

<div class="space-y-5 sm:space-y-6 pt-4 border-t border-slate-200">
  <div class="space-y-1">
    <p class="text-sm sm:text-base text-[#091E3A] font-cursive">¿Tienes comentarios o sugerencias?</p>
    <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold text-[#1a1a1a] font-heading">Deja tu mensaje</h2>
  </div>

  <form id="contact-form" class="space-y-4 sm:space-y-5" novalidate>
    <!-- Honeypot traps for bots -->
    <div class="sr-only opacity-0 absolute -left-[9999px] pointer-events-none" aria-hidden="true">
      <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" />
      <input type="text" name="_website_hp" tabindex="-1" autocomplete="off" />
    </div>

    <!-- Nombres -->
    <div class="space-y-1">
      <label for="name" class="block text-xs font-semibold text-[#1a1a1a]">Nombres completos *</label>
      <input 
        type="text" 
        id="name" 
        name="name" 
        required 
        minlength="2"
        maxlength="80"
        pattern="^[a-zA-ZáéíóúÁÉÍÓÚñÑüÜ\\s.'-]{2,80}$"
        title="Por favor ingresa tu nombre (solo letras y espacios, mín. 2 caracteres)"
        placeholder="Ej. Juan Pérez"
        autocomplete="name"
        class="w-full px-4 py-3 rounded-xl border border-slate-300 text-sm text-[#1a1a1a] placeholder-slate-400 focus:outline-none focus:border-[#091E3A] focus:ring-2 focus:ring-[#091E3A]/20 bg-slate-50/50 focus:bg-white transition-all"
      />
    </div>

    <!-- Celular -->
    <div class="space-y-1">
      <label for="phone" class="block text-xs font-semibold text-[#1a1a1a]">Número Celular *</label>
      <input 
        type="tel" 
        id="phone" 
        name="phone" 
        required 
        minlength="7"
        maxlength="20"
        pattern="^[0-9+\\s()-]{7,20}$"
        title="Ingresa un número telefónico válido (ej. 0982867413 o +593 98 286 7413)"
        placeholder="Ej. 0982867413"
        autocomplete="tel"
        class="w-full px-4 py-3 rounded-xl border border-slate-300 text-sm text-[#1a1a1a] placeholder-slate-400 focus:outline-none focus:border-[#091E3A] focus:ring-2 focus:ring-[#091E3A]/20 bg-slate-50/50 focus:bg-white transition-all"
      />
    </div>

    <!-- Email -->
    <div class="space-y-1">
      <label for="email" class="block text-xs font-semibold text-[#1a1a1a]">Email institucional o personal *</label>
      <input 
        type="email" 
        id="email" 
        name="email" 
        required 
        minlength="5"
        maxlength="100"
        placeholder="Ej. usuario@institucion.edu.ec"
        autocomplete="email"
        class="w-full px-4 py-3 rounded-xl border border-slate-300 text-sm text-[#1a1a1a] placeholder-slate-400 focus:outline-none focus:border-[#091E3A] focus:ring-2 focus:ring-[#091E3A]/20 bg-slate-50/50 focus:bg-white transition-all"
      />
    </div>

    <!-- Mensaje -->
    <div class="space-y-1">
      <div class="flex items-center justify-between">
        <label for="message" class="block text-xs font-semibold text-[#1a1a1a]">Mensaje o requerimiento *</label>
        <span id="char-counter" class="text-[11px] text-slate-400">0 / 1000</span>
      </div>
      <textarea 
        id="message" 
        name="message" 
        rows="4" 
        required
        minlength="10"
        maxlength="1000"
        placeholder="Cuéntanos tus requerimientos o disponibilidad para reunirnos."
        class="w-full px-4 py-3 rounded-xl border border-slate-300 text-sm text-[#1a1a1a] placeholder-slate-400 focus:outline-none focus:border-[#091E3A] focus:ring-2 focus:ring-[#091E3A]/20 bg-slate-50/50 focus:bg-white transition-all resize-none"
      ></textarea>
    </div>

    <!-- Botón Enviar -->
    <div class="pt-2">
      <button 
        type="submit" 
        id="submit-btn"
        class="btn-navy w-full py-3.5 sm:py-4 text-sm sm:text-base font-semibold shadow-md active:scale-95 transition-all flex items-center justify-center gap-2"
      >
        <span id="btn-text">Enviar mensaje</span>
        <svg id="btn-spinner" class="hidden animate-spin h-5 w-5 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
      </button>
    </div>

    <!-- Contenedor seguro de feedback en el DOM -->
    <div id="form-feedback" class="hidden p-4 rounded-xl text-center text-sm transition-all duration-300"></div>
  </form>
</div>

<script>
  import {
    sanitizeInput,
    detectSqlInjection,
    detectXss,
    detectCrlfInjection,
    escapeHtml,
    SecurityValidators
  } from '../utils/security';

  const form = document.getElementById('contact-form') as HTMLFormElement;
  const feedback = document.getElementById('form-feedback') as HTMLDivElement;
  const messageInput = document.getElementById('message') as HTMLTextAreaElement;
  const charCounter = document.getElementById('char-counter') as HTMLSpanElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const btnText = document.getElementById('btn-text') as HTMLSpanElement;
  const btnSpinner = document.getElementById('btn-spinner') as HTMLElement;

  // Timestamp de inicialización para trampa de velocidad de bots (< 1.5s)
  const formLoadTime = Date.now();

  // Contador de caracteres en tiempo real
  messageInput?.addEventListener('input', () => {
    if (charCounter) {
      const len = messageInput.value.length;
      charCounter.textContent = `${len} / 1000`;
      charCounter.classList.toggle('text-amber-600', len > 900);
    }
  });

  function showFeedback(type: 'success' | 'error' | 'warning', message: string, whatsappUrl = '') {
    if (!feedback) return;
    feedback.className = 'p-4 rounded-xl text-center text-sm transition-all duration-300';
    
    if (type === 'success') {
      feedback.classList.add('bg-emerald-50', 'text-emerald-900', 'border', 'border-emerald-300');
      feedback.innerHTML = `
        <div class="space-y-2">
          <div class="flex items-center justify-center gap-2 font-bold text-emerald-800">
            <svg class="w-5 h-5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
            <span>¡Mensaje recibido con éxito!</span>
          </div>
          <p class="text-xs text-slate-600 leading-relaxed">${escapeHtml(message)}</p>
          ${whatsappUrl ? `
            <div class="pt-2">
              <a href="${whatsappUrl}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-semibold shadow-sm transition-all hover:scale-105 active:scale-95">
                <svg class="w-4 h-4 fill-current" viewBox="0 0 448 512"><path d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3L72 359.2l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7.9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z"/></svg>
                <span>Confirmar por WhatsApp</span>
              </a>
            </div>
          ` : ''}
        </div>
      `;
    } else if (type === 'warning') {
      feedback.classList.add('bg-amber-50', 'text-amber-900', 'border', 'border-amber-300');
      feedback.innerHTML = `<p class="font-medium">${escapeHtml(message)}</p>`;
    } else {
      feedback.classList.add('bg-rose-50', 'text-rose-900', 'border', 'border-rose-300');
      feedback.innerHTML = `<p class="font-medium">${escapeHtml(message)}</p>`;
    }
  }

  form?.addEventListener('submit', (e) => {
    e.preventDefault();

    // 1. Detección de Bot por Velocidad (< 1.5s)
    if (Date.now() - formLoadTime < 1500) {
      console.warn('[Security] Bot detectado por velocidad de envío.');
      showFeedback('error', 'Error en el envío. Por favor intenta nuevamente.');
      return;
    }

    // 2. Detección de Bot por Honeypot
    const formData = new FormData(form);
    if (formData.get('_gotcha') || formData.get('_website_hp')) {
      console.warn('[Security] Bot detectado por trampa honeypot.');
      showFeedback('success', 'Tu solicitud ha sido procesada.');
      form.reset();
      return;
    }

    // 3. Rate Limiting por Navegador (1 envío cada 20s)
    const LAST_SUB_KEY = 'cedepro_last_contact_sub';
    const lastSub = parseInt(localStorage.getItem(LAST_SUB_KEY) || '0', 10);
    const now = Date.now();
    const cooldown = 20 * 1000;

    if (now - lastSub < cooldown) {
      const waitSeconds = Math.ceil((cooldown - (now - lastSub)) / 1000);
      showFeedback('warning', `Por favor espera ${waitSeconds} segundos antes de enviar otro mensaje.`);
      return;
    }

    // 4. Extracción y Detección de Inyecciones
    const rawName = String(formData.get('name') || '');
    const rawPhone = String(formData.get('phone') || '');
    const rawEmail = String(formData.get('email') || '');
    const rawMessage = String(formData.get('message') || '');

    // Detección proactiva de ataques SQLi / XSS / CRLF
    const hasSqlInjection = detectSqlInjection(rawName) || detectSqlInjection(rawPhone) || detectSqlInjection(rawEmail) || detectSqlInjection(rawMessage);
    const hasXss = detectXss(rawName) || detectXss(rawPhone) || detectXss(rawEmail) || detectXss(rawMessage);
    const hasCrlf = detectCrlfInjection(rawName) || detectCrlfInjection(rawPhone) || detectCrlfInjection(rawEmail);

    if (hasSqlInjection || hasXss || hasCrlf) {
      console.warn('[Security Alert] Patrón de inyección malicioso detectado y bloqueado.');
      showFeedback('error', 'Se detectaron caracteres o secuencias no permitidas en los campos. Por favor revisa tu información.');
      return;
    }

    // Sanitización rigurosa de cada campo
    const name = sanitizeInput(rawName, { maxLength: 80, allowNewlines: false });
    const phone = sanitizeInput(rawPhone, { maxLength: 20, allowNewlines: false });
    const email = sanitizeInput(rawEmail, { maxLength: 100, allowNewlines: false });
    const message = sanitizeInput(rawMessage, { maxLength: 1000, allowNewlines: true });

    // Validaciones de formato con SecurityValidators
    if (!SecurityValidators.name(name)) {
      showFeedback('error', 'Por favor ingresa un nombre válido (mínimo 2 caracteres, solo letras).');
      document.getElementById('name')?.focus();
      return;
    }

    if (!SecurityValidators.phone(phone)) {
      showFeedback('error', 'Por favor ingresa un número de teléfono válido.');
      document.getElementById('phone')?.focus();
      return;
    }

    if (!SecurityValidators.email(email)) {
      showFeedback('error', 'Por favor ingresa un correo electrónico institucional o personal válido.');
      document.getElementById('email')?.focus();
      return;
    }

    if (!SecurityValidators.message(message)) {
      showFeedback('error', 'Por favor describe tu consulta con al menos 10 caracteres.');
      document.getElementById('message')?.focus();
      return;
    }

    // 5. Estado de Envío Seguro (Previene doble submit)
    if (submitBtn) {
      submitBtn.disabled = true;
      btnText?.classList.add('hidden');
      btnSpinner?.classList.remove('hidden');
    }

    try {
      localStorage.setItem(LAST_SUB_KEY, now.toString());

      const waText = encodeURIComponent(
        `*Nuevo Contacto Web - Cedepro Ecuador*\n` +
        `*Nombres:* ${name}\n` +
        `*Celular:* ${phone}\n` +
        `*Email:* ${email}\n` +
        `*Mensaje:* ${message}`
      );
      const waUrl = `https://wa.me/593982867413?text=${waText}`;

      showFeedback(
        'success',
        'Hemos recibido tus datos de forma segura. Nuestro equipo se pondrá en contacto a la brevedad posible.',
        waUrl
      );

      form.reset();
      if (charCounter) charCounter.textContent = '0 / 1000';
    } catch (err) {
      showFeedback('error', 'Ocurrió un error inesperado al procesar tu solicitud. Por favor contáctanos vía WhatsApp.');
    } finally {
      if (submitBtn) {
        submitBtn.disabled = false;
        btnText?.classList.remove('hidden');
        btnSpinner?.classList.add('hidden');
      }
    }
  });
</script>
