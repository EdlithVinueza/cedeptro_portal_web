---
const currentYear = new Date().getFullYear();
---

<footer class="relative bg-[#091E3A] text-[#cbd5e1] border-t border-[#0d2d59] pt-12 sm:pt-16 pb-8 sm:pb-12 overflow-hidden" style="background-image: url('/assets/fondo-scaled.webp'); background-repeat: repeat;">
  <div class="absolute inset-0 bg-[#091E3A]/90 pointer-events-none"></div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 z-10">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 sm:gap-12 mb-10">
      
      <!-- Columna 1: Logo, Redes y Copyright -->
      <div class="space-y-6 sm:col-span-2 lg:col-span-1">
        <a href="/" class="inline-block transition-transform hover:opacity-90 active:scale-95" aria-label="Inicio">
          <img 
            src="/assets/logo-cedepro-1024x259.webp" 
            alt="Cedepro Ecuador" 
            class="max-w-[200px] sm:max-w-[240px] h-auto object-contain"
            width="240"
            height="60"
            loading="lazy"
          />
        </a>
        
        <div class="space-y-3">
          <p class="text-white text-sm font-semibold">¡Encuéntranos!</p>
          <div class="flex items-center gap-3">
            <!-- Instagram -->
            <a 
              href="https://www.instagram.com/cedepro.ec/" 
              target="_blank" 
              rel="noopener noreferrer" 
              aria-label="Instagram de Cedepro Ecuador"
              class="w-10 h-10 rounded-full border border-white/40 hover:border-white text-white flex items-center justify-center transition-all hover:scale-110 active:scale-95"
            >
              <svg class="w-4 h-4 fill-none stroke-current" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
              </svg>
            </a>

            <!-- Facebook -->
            <a 
              href="https://www.facebook.com/CedeproEcuador" 
              target="_blank" 
              rel="noopener noreferrer" 
              aria-label="Facebook de Cedepro Ecuador"
              class="w-10 h-10 rounded-full border border-white/40 hover:border-white text-white flex items-center justify-center transition-all hover:scale-110 active:scale-95"
            >
              <svg class="w-4 h-4 fill-current" viewBox="0 0 320 512"><path d="M279.14 288l14.22-92.66h-88.91v-60.13c0-25.35 12.42-50.06 52.24-50.06h40.42V6.26S260.43 0 225.36 0c-73.22 0-121.08 44.38-121.08 124.72v70.62H22.89V288h81.39v224h100.17V288z"/></svg>
            </a>

            <!-- LinkedIn -->
            <a 
              href="https://www.linkedin.com/in/cedepro-ecuador-0200a9212/" 
              target="_blank" 
              rel="noopener noreferrer" 
              aria-label="LinkedIn de Cedepro Ecuador"
              class="w-10 h-10 rounded-full border border-white/40 hover:border-white text-white flex items-center justify-center transition-all hover:scale-110 active:scale-95"
            >
              <svg class="w-4 h-4 fill-current" viewBox="0 0 448 512"><path d="M100.28 448H7.4V148.9h92.88zM53.79 108.1C24.09 108.1 0 83.5 0 53.8a53.79 53.79 0 0 1 107.58 0c0 29.7-24.1 54.3-53.79 54.3zM447.9 448h-92.68V302.4c0-34.7-.7-79.2-48.29-79.2-48.29 0-55.69 37.7-55.69 76.7V448h-92.78V148.9h89.08v40.8h1.3c12.4-23.5 42.69-48.3 87.88-48.3 94 0 111.28 61.9 111.28 142.3V448z"/></svg>
            </a>

            <!-- WhatsApp -->
            <a 
              href="http://wa.me/593982867413" 
              target="_blank" 
              rel="noopener noreferrer" 
              aria-label="WhatsApp de Cedepro Ecuador"
              class="w-10 h-10 rounded-full border border-white/40 hover:border-white text-white flex items-center justify-center transition-all hover:scale-110 active:scale-95"
            >
              <svg class="w-4 h-4 fill-current" viewBox="0 0 448 512"><path d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3L72 359.2l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7.9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z"/></svg>
            </a>
          </div>
        </div>

        <p class="text-xs text-slate-400">© {currentYear} CEDEPRO – Todos los derechos reservados.</p>
      </div>

      <!-- Columna 2: Links Rápidos -->
      <div class="space-y-4">
        <h4 class="text-white font-bold text-base sm:text-lg font-heading">Links Rápidos</h4>
        <ul class="space-y-2.5 text-sm text-slate-300">
          <li><a href="/sobre-nosotros" class="hover:text-[#f5a623] transition-colors inline-block py-0.5">Sobre nosotros</a></li>
          <li><a href="/portafolio" class="hover:text-[#f5a623] transition-colors inline-block py-0.5">Portafolio</a></li>
          <li><a href="/politicas-objetivos" class="hover:text-[#f5a623] transition-colors inline-block py-0.5">Gestión de la Calidad</a></li>
          <li><a href="/contacto" class="hover:text-[#f5a623] transition-colors inline-block py-0.5">Contáctanos</a></li>
        </ul>
      </div>

      <!-- Columna 3: Contacto e Imagen IAS -->
      <div class="space-y-4">
        <h4 class="text-white font-bold text-base sm:text-lg font-heading">Contacto</h4>
        <div class="text-sm text-slate-300 leading-relaxed space-y-1.5">
          <p class="break-words">Antonio de Ulloa N34-419 y Abelardo Moncayo</p>
          <p>Teléfono: <a href="tel:023317118" class="hover:text-white transition-colors">(02) 331 7118</a> / <a href="tel:0982867413" class="hover:text-white transition-colors">098 286 7413</a></p>
          <p class="break-all">Email: <a href="mailto:gerencia@cedeproec.com" class="hover:text-[#f5a623] transition-colors underline underline-offset-2">gerencia@cedeproec.com</a></p>
        </div>
        <div class="pt-2">
          <img 
            src="/assets/IAS-1024x571.webp" 
            alt="IAS ACCREDITED STAREGISTER ISO 9001:2015" 
            class="max-w-[160px] sm:max-w-[180px] h-auto object-contain"
            width="180"
            height="100"
            loading="lazy"
          />
        </div>
      </div>

    </div>
  </div>
</footer>
