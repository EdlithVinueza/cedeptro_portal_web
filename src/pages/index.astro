---
import Layout from '../layouts/Layout.astro';

const partnerLogosRow1 = [
  '01-2-300x77.png',
  '02-2-300x101.png',
  '03-1-300x90.png',
  '04-1-300x106.png'
];

const partnerLogosRow2 = [
  '05-300x55.png',
  '06.png',
  '07.png',
  '08-300x128.png',
  '09.png',
  '10-300x97.png'
];

const partnerLogosRow3 = [
  '11-300x122.png',
  '12-300x108.png',
  '13-300x86.png',
  '14-300x62.png',
  '15-300x151.png',
  '16-300x74.png'
];

/**
 * Función para controlar los porcentajes y opacidad del degradado del Hero.
 * @param darkCoveragePercentage - Porcentaje inicial de cobertura oscura sólida (ej: 35 = 35%)
 * @param fadeEndPercentage - Porcentaje donde el degradado se vuelve 100% transparente (ej: 85 = 85%)
 * @param darkColor - Color base oscuro corporativo (#07162c)
 */
function calculateHeroGradient(darkCoveragePercentage = 40, fadeEndPercentage = 85, darkColor = '#07162c') {
  const midPoint = Math.round((darkCoveragePercentage + fadeEndPercentage) / 2);
  return `linear-gradient(to right, ${darkColor} 0%, ${darkColor} ${darkCoveragePercentage}%, rgba(7, 22, 44, 0.85) ${midPoint}%, rgba(7, 22, 44, 0) ${fadeEndPercentage}%)`;
}

// Puedes modificar los porcentajes aquí directamente (ej: 40% inicio, 85% final):
const heroGradientStyle = calculateHeroGradient(40, 85);
---

<Layout 
  title="Cedepro Ecuador – Cedepro"
  description="Aliados estratégicos, impulsando la calidad y el desarrollo sostenible en la educación"
>
  
  <!-- 1. HERO HEADER SECTION (100% HEIGHT CON DEGRADADO CONFIGURABLE) -->
  <section class="relative min-h-[calc(100vh-4rem)] sm:min-h-[calc(100vh-5rem)] flex items-center px-4 sm:px-6 lg:px-12 py-16 sm:py-24 bg-cover bg-center md:bg-right overflow-hidden" style="background-image: url('/assets/new_hero.png');">
    <!-- Degradado dinámico de izquierda a derecha controlado por la función calculateHeroGradient -->
    <div class="absolute inset-0 pointer-events-none" style={`background: ${heroGradientStyle};`}></div>
    <div class="absolute inset-0 bg-black/20 md:bg-transparent pointer-events-none"></div>
    
    <div class="relative max-w-7xl mx-auto w-full z-10">
      <div class="max-w-3xl space-y-4 sm:space-y-6 text-left">
        <p class="text-white text-xl sm:text-2xl md:text-3xl font-cursive">
          Aliados estratégicos,
        </p>
        <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold text-white tracking-tight leading-tight sm:leading-snug md:leading-tight font-heading">
          Impulsando la calidad y el desarrollo sostenible en la educación
        </h1>
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3.5 sm:gap-4 pt-4">
          <a href="/politicas-objetivos" class="btn-outline-white">
            Gestión de la Calidad
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. TRES COLUMNAS FOTOGRÁFICAS ORIGINALES (DISEÑO, ACREDITACIÓN, CONSULTORÍA) -->
  <section class="w-full bg-[#091E3A]">
    <div class="grid grid-cols-1 md:grid-cols-3">
      
      <!-- Banner 1: Diseño de Carreras (descarga-21.png) -->
      <a href="/portafolio" class="relative group h-60 sm:h-72 md:h-80 overflow-hidden block bg-cover bg-center transition-all duration-300" style="background-image: url('/assets/descarga-21.png');">
        <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-black/10 flex flex-col justify-end p-6 sm:p-8 group-hover:from-black/95 transition-colors">
          <h3 class="text-xl sm:text-2xl font-bold text-white font-heading transform group-hover:-translate-y-0.5 transition-transform">Diseño de Carreras</h3>
          <p class="text-sm sm:text-base text-slate-200 font-cursive italic mt-1">Planes académicos estratégicos</p>
        </div>
      </a>

      <!-- Banner 2: Procesos de acreditación (acreditacion-1.png) -->
      <a href="/portafolio" class="relative group h-60 sm:h-72 md:h-80 overflow-hidden block bg-cover bg-center transition-all duration-300 border-t md:border-t-0 md:border-l md:border-r border-white/10" style="background-image: url('/assets/acreditacion-1.png');">
        <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-black/10 flex flex-col justify-end p-6 sm:p-8 group-hover:from-black/95 transition-colors">
          <h3 class="text-xl sm:text-2xl font-bold text-white font-heading transform group-hover:-translate-y-0.5 transition-transform">Procesos de acreditación</h3>
          <p class="text-sm sm:text-base text-slate-200 font-cursive italic mt-1">Cumplimiento y excelencia</p>
        </div>
      </a>

      <!-- Banner 3: Consultoría en gestión (descarga-42.png) -->
      <a href="/portafolio" class="relative group h-60 sm:h-72 md:h-80 overflow-hidden block bg-cover bg-center transition-all duration-300 border-t md:border-t-0 border-white/10" style="background-image: url('/assets/descarga-42.png');">
        <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-black/10 flex flex-col justify-end p-6 sm:p-8 group-hover:from-black/95 transition-colors">
          <h3 class="text-xl sm:text-2xl font-bold text-white font-heading transform group-hover:-translate-y-0.5 transition-transform">Consultoría en gestión</h3>
          <p class="text-sm sm:text-base text-slate-200 font-cursive italic mt-1">Administrativa y normativa</p>
        </div>
      </a>

    </div>
  </section>

  <!-- 4. ÚNETE AL CAMBIO EN EXCELENCIA EDUCATIVA (FONDO MOSTAZA / OCRE #b8860b) -->
  <section class="bg-[#b8860b] py-14 sm:py-20 px-4 sm:px-6 lg:px-8 text-white">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
      
      <!-- Izquierda -->
