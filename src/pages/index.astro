        ))}
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 gap-2.5 sm:gap-3 items-center">
        {partnerLogosRow2.map((logo) => (
          <div class="h-16 sm:h-20 bg-white rounded-2xl shadow-sm border border-slate-200/80 flex items-center justify-center p-2.5 sm:p-3 hover:shadow-md transition-all hover:scale-[1.02]">
            <img src={`/assets/${logo}`} alt="Aliado Cedepro" class="max-h-10 sm:max-h-12 max-w-full object-contain" loading="lazy" />
          </div>
        ))}
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 gap-2.5 sm:gap-3 items-center">
        {partnerLogosRow3.map((logo) => (
          <div class="h-16 sm:h-20 bg-white rounded-2xl shadow-sm border border-slate-200/80 flex items-center justify-center p-2.5 sm:p-3 hover:shadow-md transition-all hover:scale-[1.02]">
            <img src={`/assets/${logo}`} alt="Aliado Cedepro" class="max-h-10 sm:max-h-12 max-w-full object-contain" loading="lazy" />
          </div>
        ))}
      </div>

    </div>
  </section>

</Layout>
