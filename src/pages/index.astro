          <p class="text-xs sm:text-sm tracking-wider uppercase text-slate-200 font-medium">Carreras aprobadas</p>
        </div>

        <!-- Stat 2 -->
        <div class="space-y-1">
          <p class="text-3xl sm:text-4xl lg:text-5xl font-bold text-[#f5a623] font-heading">+10</p>
          <p class="text-xs sm:text-sm tracking-wider uppercase text-slate-200 font-medium">Inst. Tecnológicos creados</p>
        </div>

        <!-- Stat 3 -->
        <div class="space-y-1">
          <p class="text-3xl sm:text-4xl lg:text-5xl font-bold text-[#f5a623] font-heading">+2500</p>
          <p class="text-xs sm:text-sm tracking-wider uppercase text-slate-200 font-medium">Profesionales capacitados</p>
        </div>

        <!-- Stat 4 -->
        <div class="space-y-1">
          <p class="text-3xl sm:text-4xl lg:text-5xl font-bold text-[#f5a623] font-heading">+30</p>
          <p class="text-xs sm:text-sm tracking-wider uppercase text-slate-200 font-medium">Instituciones asesoradas</p>
        </div>

      </div>

    </div>
  </section>

  <!-- 7. ALIADOS (PARALLAX CON need-technology-partner.jpg CON TARJETAS BLANCAS) -->
