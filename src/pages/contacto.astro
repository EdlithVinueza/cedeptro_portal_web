---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="Contáctanos – Cedepro Ecuador"
  description="¿Tienes inquietudes? ¡Búscanos! Comunícate con Cedepro Ecuador."
>
  
  <section class="min-h-screen grid grid-cols-1 lg:grid-cols-12 bg-white">
    
    <!-- Left Column: Building Photo with Dark Overlay (ft-fachada-cedepro-2025.webp) -->
    <div class="lg:col-span-5 relative min-h-[40vh] sm:min-h-[50vh] lg:min-h-full flex items-center justify-center p-6 sm:p-10 lg:p-12 text-center overflow-hidden">
      <img 
        src="/assets/ft-fachada-cedepro-2025.webp" 
        alt="Fachada Cedepro Ecuador" 
        class="absolute inset-0 w-full h-full object-cover"
        loading="eager"
      />
      <div class="absolute inset-0 bg-[#091E3A]/85 backdrop-blur-[1px]"></div>

      <div class="relative z-10 space-y-4 sm:space-y-6 max-w-sm">
        <div class="space-y-1 sm:space-y-2">
          <p class="text-xl sm:text-2xl text-[#f5a623] font-cursive">¿Tienes inquietudes?</p>
          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-white font-heading tracking-tight leading-tight">¡Búscanos!</h1>
        </div>

        <!-- Social Circles (Facebook, Instagram, LinkedIn) -->
        <div class="flex items-center justify-center gap-3 sm:gap-4 pt-2 sm:pt-4">
          <a href="https://www.facebook.com/CedeproEcuador" target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="w-10 h-10 sm:w-11 sm:h-11 rounded-full border border-white/40 hover:border-white text-white flex items-center justify-center transition-all hover:scale-110 active:scale-95">
            <svg class="w-4 h-4 sm:w-5 sm:h-5 fill-current" viewBox="0 0 320 512"><path d="M279.14 288l14.22-92.66h-88.91v-60.13c0-25.35 12.42-50.06 52.24-50.06h40.42V6.26S260.43 0 225.36 0c-73.22 0-121.08 44.38-121.08 124.72v70.62H22.89V288h81.39v224h100.17V288z"/></svg>
          </a>
          <a href="https://www.instagram.com/cedepro.ec/" target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="w-10 h-10 sm:w-11 sm:h-11 rounded-full border border-white/40 hover:border-white text-white flex items-center justify-center transition-all hover:scale-110 active:scale-95">
            <svg class="w-4 h-4 sm:w-5 sm:h-5 fill-none stroke-current" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
            </svg>
          </a>
          <a href="https://www.linkedin.com/in/cedepro-ecuador-0200a9212/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="w-10 h-10 sm:w-11 sm:h-11 rounded-full border border-white/40 hover:border-white text-white flex items-center justify-center transition-all hover:scale-110 active:scale-95">
            <svg class="w-4 h-4 sm:w-5 sm:h-5 fill-current" viewBox="0 0 448 512"><path d="M100.28 448H7.4V148.9h92.88zM53.79 108.1C24.09 108.1 0 83.5 0 53.8a53.79 53.79 0 0 1 107.58 0c0 29.7-24.1 54.3-53.79 54.3zM447.9 448h-92.68V302.4c0-34.7-.7-79.2-48.29-79.2-48.29 0-55.69 37.7-55.69 76.7V448h-92.78V148.9h89.08v40.8h1.3c12.4-23.5 42.69-48.3 87.88-48.3 94 0 111.28 61.9 111.28 142.3V448z"/></svg>
          </a>
        </div>
      </div>
    </div>

    <!-- Right Column: Map, Info and Form -->
    <div class="lg:col-span-7 p-5 sm:p-8 md:p-12 lg:p-16 space-y-8 sm:space-y-10">
      
      <!-- Google Maps Embed -->
      <div class="rounded-2xl sm:rounded-3xl overflow-hidden border border-slate-200 shadow-md h-56 sm:h-72 w-full">
        <iframe 
          src="https://maps.google.com/maps?q=cedepro%20ecuador&t=m&z=17&output=embed&iwloc=near" 
          width="100%" 
          height="100%" 
          style="border:0;" 
          allowfullscreen="" 
          loading="lazy" 
          title="Ubicación Cedepro Ecuador"
        ></iframe>
      </div>

      <!-- Contact Info -->
      <div class="space-y-4 text-xs sm:text-sm text-[#4a4a4a]">
        <div>
          <h3 class="font-bold text-[#1a1a1a] text-sm sm:text-base font-heading">Dirección</h3>
          <p class="mt-0.5">Antonio de Ulloa N34-419 y Abelardo Moncayo</p>
        </div>

        <div>
          <h3 class="font-bold text-[#1a1a1a] text-sm sm:text-base font-heading">Teléfono</h3>
          <p class="mt-0.5">
            <a href="tel:023317118" class="hover:text-[#091E3A] transition-colors">(02) 331 7118</a> / 
            <a href="tel:0982867413" class="hover:text-[#091E3A] transition-colors">098 286 7413</a>
          </p>
        </div>

        <div>
          <h3 class="font-bold text-[#1a1a1a] text-sm sm:text-base font-heading">Horarios de atención</h3>
          <p class="mt-0.5">Lunes a viernes de 8h00 a 17h00</p>
        </div>
      </div>

      <!-- Contact Form -->
      <div class="space-y-5 sm:space-y-6 pt-4 border-t border-slate-200">
        <div class="space-y-1">
          <p class="text-sm sm:text-base text-[#091E3A] font-cursive">¿Tienes comentarios o sugerencias?</p>
          <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold text-[#1a1a1a] font-heading">Deja tu mensaje</h2>
        </div>

        <form id="contact-form" class="space-y-4 sm:space-y-5">
          <!-- Honeypot -->
          <input type="text" name="_gotcha" style="display:none !important;" tabindex="-1" autocomplete="off" />

          <!-- Nombres -->
          <div class="space-y-1">
            <label for="name" class="block text-xs font-semibold text-[#1a1a1a]">Nombres completos</label>
            <input 
              type="text" 
              id="name" 
              name="name" 
              required 
              placeholder="Ej. Juan Pérez"
              class="w-full px-4 py-3 rounded-xl border border-slate-300 text-sm text-[#1a1a1a] placeholder-slate-400 focus:outline-none focus:border-[#091E3A] focus:ring-2 focus:ring-[#091E3A]/20 bg-slate-50/50 focus:bg-white transition-all"
            />
          </div>

          <!-- Celular -->
          <div class="space-y-1">
            <label for="phone" class="block text-xs font-semibold text-[#1a1a1a]">Número Celular</label>
            <input 
              type="tel" 
              id="phone" 
              name="phone" 
              required 
              placeholder="Ej. 0991234567"
              class="w-full px-4 py-3 rounded-xl border border-slate-300 text-sm text-[#1a1a1a] placeholder-slate-400 focus:outline-none focus:border-[#091E3A] focus:ring-2 focus:ring-[#091E3A]/20 bg-slate-50/50 focus:bg-white transition-all"
            />
          </div>

          <!-- Email -->
          <div class="space-y-1">
            <label for="email" class="block text-xs font-semibold text-[#1a1a1a]">Email institucional o personal</label>
            <input 
              type="email" 
              id="email" 
              name="email" 
              required 
              placeholder="Ej. usuario@institucion.edu.ec"
              class="w-full px-4 py-3 rounded-xl border border-slate-300 text-sm text-[#1a1a1a] placeholder-slate-400 focus:outline-none focus:border-[#091E3A] focus:ring-2 focus:ring-[#091E3A]/20 bg-slate-50/50 focus:bg-white transition-all"
            />
          </div>

          <!-- Mensaje -->
          <div class="space-y-1">
            <label for="message" class="block text-xs font-semibold text-[#1a1a1a]">Mensaje o requerimiento</label>
            <textarea 
              id="message" 
              name="message" 
              rows="4" 
              placeholder="Cuéntanos tus requerimientos o disponibilidad para reunirnos."
              class="w-full px-4 py-3 rounded-xl border border-slate-300 text-sm text-[#1a1a1a] placeholder-slate-400 focus:outline-none focus:border-[#091E3A] focus:ring-2 focus:ring-[#091E3A]/20 bg-slate-50/50 focus:bg-white transition-all resize-none"
            ></textarea>
          </div>

          <!-- Botón Enviar -->
          <div class="pt-2">
            <button 
              type="submit" 
              class="btn-navy w-full py-3.5 sm:py-4 text-sm sm:text-base font-semibold shadow-md active:scale-95"
            >
              Enviar mensaje
            </button>
          </div>

          <div id="form-feedback" class="hidden p-4 rounded-xl text-center text-sm"></div>
        </form>
      </div>

    </div>
  </section>

</Layout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const feedback = document.getElementById('form-feedback');

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }

    const formData = new FormData(form);
    if (formData.get('_gotcha')) return;

    const name = formData.get('name');
    const phone = formData.get('phone');
    const email = formData.get('email');
    const message = formData.get('message');

    const waText = encodeURIComponent(
      `*Nuevo Contacto Web - Cedepro Ecuador*\n` +
      `*Nombres:* ${name}\n` +
      `*Celular:* ${phone}\n` +
      `*Email:* ${email}\n` +
      `*Mensaje:* ${message}`
    );

    if (feedback) {
      feedback.classList.remove('hidden');
      feedback.classList.add('bg-emerald-50', 'text-emerald-800', 'border', 'border-emerald-300');
      feedback.innerHTML = `
        <div class="space-y-2">
          <p class="font-bold">¡Mensaje enviado con éxito!</p>
          <p class="text-xs text-slate-600">¿Deseas atención inmediata? También puedes escribirnos directamente a WhatsApp:</p>
          <a href="https://wa.me/593982867413?text=${waText}" target="_blank" class="inline-block mt-2 px-5 py-2 rounded-full bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-semibold">
            Abrir WhatsApp
          </a>
        </div>
      `;
    }

    form.reset();
  });
</script>
