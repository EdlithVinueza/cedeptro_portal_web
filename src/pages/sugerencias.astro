---
import Layout from "../layouts/Layout.astro";
import ContactForm from "../components/ContactForm.astro";
---

<Layout
  title="Buzón de Sugerencias – Cedepro Ecuador"
  description="Déjanos tus sugerencias para ayudarnos a mejorar nuestros servicios."
>
  <section class="min-h-screen grid grid-cols-1 lg:grid-cols-12 bg-white">
    <!-- Left Column: Building Photo with Dark Overlay (ft-fachada-cedepro-2025.webp) -->
    <div
      class="lg:col-span-5 relative min-h-[40vh] sm:min-h-[50vh] lg:min-h-full flex items-center justify-center p-6 sm:p-10 lg:p-12 text-center overflow-hidden"
    >
      <img
        src="/assets/nosotros/fachada_2025.webp"
        alt="Fachada Cedepro Ecuador"
        class="absolute inset-0 w-full h-full object-cover"
        loading="eager"
      />
      <div class="absolute inset-0 bg-[#091E3A]/85 backdrop-blur-[1px]"></div>

      <div class="relative z-10 space-y-4 sm:space-y-6 max-w-sm">
        <div class="space-y-1 sm:space-y-2">
          <p class="text-xl sm:text-2xl text-[#D48D15] font-cursive">
            Tu opinión nos importa
          </p>
          <h1
            class="text-4xl sm:text-5xl lg:text-6xl font-bold text-white font-heading tracking-tight leading-tight"
          >
            Buzón de Sugerencias
          </h1>
        </div>
      </div>
    </div>

    <!-- Right Column: Info and Form -->
    <div
      class="lg:col-span-7 p-5 sm:p-8 md:p-12 lg:p-16 space-y-8 sm:space-y-10 flex flex-col justify-center"
    >
      <div class="space-y-2">
        <h2 class="text-2xl sm:text-3xl font-bold text-[#091E3A] font-heading">
          Déjanos tus sugerencias
        </h2>
        <p class="text-slate-600 text-sm sm:text-base">
          Valoramos tus comentarios y aportes para seguir mejorando nuestros
          servicios y atención. Por favor, completa el siguiente formulario.
        </p>
      </div>
      <!-- Modular Hardened Contact Form Component -->
      <ContactForm hideHeader={true} />
    </div>
  </section>
</Layout>
