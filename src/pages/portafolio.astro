---
import Layout from '../layouts/Layout.astro';

const services = [
  {
    title: "Asesoría Integral 360°",
    description: "Soluciones integrales para el crecimiento de tu institución, abarcando aspectos legales, administrativos, financieros y gestión documental. Nuestro equipo experto identifica oportunidades de mejora y asegura el cumplimiento normativo con estrategias eficientes.",
    beneficios: "Gestión simplificada, optimización administrativa y cumplimiento sin complicaciones.",
    icon: `<path d="M488 192H336v56c0 39.7-32.3 72-72 72s-72-32.3-72-72V126.4l-64.9 39C107.8 176.9 96 197.8 96 220.2v47.3l-80 46.2C.7 322.5-4.6 342.1 4.3 357.4l80 138.6c8.8 15.3 28.4 20.5 43.7 11.7L231.4 448H368c35.3 0 64-28.7 64-64h16c17.7 0 32-14.3 32-32v-64h8c13.3 0 24-10.7 24-24v-48c0-13.3-10.7-24-24-24zm147.7-37.4L555.7 16C546.9.7 527.3-4.5 512 4.3L408.6 64H306.4c-12 0-23.7 3.4-33.9 9.7L239 94.6c-9.4 5.8-15 16.1-15 27.1V248c0 22.1 17.9 40 40 40s40-17.9 40-40v-88h184c30.9 0 56 25.1 56 56v28.5l80-46.2c15.3-8.9 20.5-28.4 11.7-43.7z"/>`,
    viewBox: "0 0 640 512"
  },
  {
    title: "Career Builder",
    description: "Diseñamos y transformamos carreras de tercer y cuarto nivel para que se adapten a las demandas actuales del mercado y las tendencias educativas. Acompañamos el proceso desde la planificación curricular hasta la implementación, asegurando que cada programa sea relevante, atractivo y sostenible.",
    beneficios: "Programas alineados con la realidad del mercado, metodologías innovadoras y optimización académica.",
    icon: `<path d="M622.34 153.2L343.4 67.5c-15.2-4.67-31.6-4.67-46.79 0L17.66 153.2c-23.54 7.23-23.54 38.36 0 45.59l48.63 14.94c-10.67 13.19-17.23 29.28-17.88 46.9C38.78 266.15 32 276.11 32 288c0 10.78 5.68 19.85 13.86 25.65L20.33 428.53C18.11 438.52 25.71 448 35.94 448h56.11c10.24 0 17.84-9.48 15.62-19.47L82.14 313.65C90.32 307.85 96 298.78 96 288c0-11.57-6.47-21.25-15.66-26.87.76-15.02 8.44-28.3 20.69-36.72L296.6 284.5c9.06 2.78 26.44 6.25 46.79 0l278.95-85.7c23.55-7.24 23.55-38.36 0-45.6zM352.79 315.09c-28.53 8.76-52.84 3.92-65.59 0l-145.02-44.55L128 384c0 35.35 85.96 64 192 64s192-28.65 192-64l-14.18-113.47-145.03 44.56z"/>`,
    viewBox: "0 0 640 512"
  },
  {
    title: "Condición de Superior Universitario",
    description: "Guiamos a instituciones en el proceso de obtener el reconocimiento como educación superior, cumpliendo con normativas y fortaleciendo su identidad académica. Nuestro enfoque combina análisis estratégico, documentación detallada y gestión eficiente para que alcances este hito sin obstáculos.",
    beneficios: "Cumplimiento normativo, fortalecimiento institucional y acompañamiento experto.",
    icon: `<path d="M496 128v16a8 8 0 0 1-8 8h-24v12c0 6.627-5.373 12-12 12H60c-6.627 0-12-5.373-12-12v-12H24a8 8 0 0 1-8-8v-16a8 8 0 0 1 4.941-7.392l232-88a7.996 7.996 0 0 1 6.118 0l232 88A8 8 0 0 1 496 128zm-24 304H40c-13.255 0-24 10.745-24 24v16a8 8 0 0 0 8 8h464a8 8 0 0 0 8-8v-16c0-13.255-10.745-24-24-24zM96 192v192H60c-6.627 0-12 5.373-12 12v20h416v-20c0-6.627-5.373-12-12-12h-36V192h-64v192h-64V192h-64v192h-64V192H96z"/>`,
    viewBox: "0 0 512 512"
  },
  {
    title: "Creación de Unidades Académicas",
    description: "Fortalecemos la estructura universitaria mediante la creación de nuevas áreas estratégicas, diseñadas para expandir la oferta académica y mejorar el posicionamiento institucional. Cada unidad se adapta a las necesidades y objetivos de la institución.",
    beneficios: "Expansión académica, optimización de estructuras organizativas y enfoque en innovación.",
    icon: `<path d="M500 128c6.627 0 12-5.373 12-12V44c0-6.627-5.373-12-12-12h-72c-6.627 0-12 5.373-12 12v12H96V44c0-6.627-5.373-12-12-12H12C5.373 32 0 37.373 0 44v72c0 6.627 5.373 12 12 12h12v256H12c-6.627 0-12 5.373-12 12v72c0 6.627 5.373 12 12 12h72c6.627 0 12-5.373 12-12v-12h320v12c0 6.627 5.373 12 12 12h72c6.627 0 12-5.373 12-12v-72c0-6.627-5.373-12-12-12h-12V128h12zm-52-64h32v32h-32V64zM32 64h32v32H32V64zm32 384H32v-32h32v32zm416 0h-32v-32h32v32zm-40-64h-12c-6.627 0-12 5.373-12 12v12H96v-12c0-6.627-5.373-12-12-12H72V128h12c6.627 0 12-5.373 12-12v-12h320v12c0 6.627 5.373 12 12 12h12v256z"/>`,
    viewBox: "0 0 512 512"
  },
  {
    title: "AWLA Formación Continua",
    description: "Desarrollamos formación bajo demanda en bienestar, habilidades blandas y docencia. AWLA integra simuladores, IA en contenidos y certificaciones de calidad, adaptándose al ritmo y necesidades de cada participante, asegurando una experiencia de aprendizaje flexible y efectiva.",
    beneficios: "Acceso flexible, certificaciones reconocidas y herramientas tecnológicas avanzadas.",
    icon: `<path d="M512 48v288c0 26.5-21.5 48-48 48h-48V176c0-44.1-35.9-80-80-80H128V48c0-26.5 21.5-48 48-48h288c26.5 0 48 21.5 48 48zM384 176v288c0 26.5-21.5 48-48 48H48c-26.5 0-48-21.5-48-48V176c0-26.5 21.5-48 48-48h288c26.5 0 48 21.5 48 48zm-68 28c0-6.6-5.4-12-12-12H76c-6.6 0-12 5.4-12 12v52h252v-52z"/>`,
    viewBox: "0 0 512 512"
  },
  {
    title: "Amarawasi Red de Bienestar",
    description: "Facilitamos el manejo de crisis, distribución de kits y capacitación especializada para fortalecer el bienestar en instituciones y comunidades. Amarauasi ofrece soluciones prácticas en gestión emocional, prevención de riesgos y fortalecimiento colectivo.",
    beneficios: "Apoyo en crisis, intervención efectiva y estrategias de bienestar social.",
    icon: `<path d="M462.3 62.6C407.5 15.9 326 24.3 275.7 76.2L256 96.5l-19.7-20.3C186.1 24.3 104.5 15.9 49.7 62.6c-62.8 53.6-66.1 149.8-9.9 207.9l193.5 199.8c12.5 12.9 32.8 12.9 45.3 0l193.5-199.8c56.3-58.1 53-154.3-9.8-207.9z"/>`,
    viewBox: "0 0 512 512"
  }
];

const accreditationService = {
  title: "Acreditación ISO 21001:2018",
  description: "Garantizamos el cumplimiento de estándares de calidad educativa mediante asesoría especializada y metodologías probadas. Desde el diagnóstico hasta la implementación, acompañamos el proceso para fortalecer la excelencia institucional.",
  beneficios: "Certificación internacional, calidad académica fortalecida y reconocimiento institucional.",
  icon: `<path d="M458.622 255.92l45.985-45.005c13.708-12.977 7.316-36.039-10.664-40.339l-62.65-15.99 17.661-62.015c4.991-17.838-11.829-34.663-29.661-29.671l-61.994 17.667-15.984-62.671C337.085.197 313.765-6.276 300.99 7.228L256 53.57 211.011 7.229c-12.63-13.351-36.047-7.234-40.325 10.668l-15.984 62.671-61.995-17.667C74.87 57.907 58.056 74.738 63.046 92.572l17.661 62.015-62.65 15.99C.069 174.878-6.31 197.944 7.392 210.915l45.985 45.005-45.985 45.004c-13.708 12.977-7.316 36.039 10.664 40.339l62.65 15.99-17.661 62.015c-4.991 17.838 11.829 34.663 29.661 29.671l61.994-17.667 15.984 62.671c4.439 18.575 27.696 24.018 40.325 10.668L256 458.61l44.989 46.001c12.5 13.488 35.987 7.486 40.325-10.668l15.984-62.671 61.994 17.667c17.836 4.994 34.651-11.837 29.661-29.671l-17.661-62.015 62.65-15.99c17.987-4.302 24.366-27.367 10.664-40.339l-45.984-45.004z"/>`,
  viewBox: "0 0 512 512"
};
---

<Layout 
  title="Portafolio – Cedepro Ecuador"
  description="Impulsamos el futuro de la educación con soluciones estratégicas adaptadas a cada institución."
>
  
  <!-- 1. HERO BANNER (PARALLAX CON 896669d7-fe7b-438a-8483-c9755de831ed.png) -->
  <section class="relative min-h-[calc(100vh-4rem)] sm:min-h-[calc(100vh-5rem)] flex items-center justify-center text-center px-4 sm:px-6 lg:px-8 py-20 sm:py-28 bg-fixed bg-cover bg-center overflow-hidden" style="background-image: url('/assets/generales/grafico_1.png');">
    <div class="absolute inset-0 bg-[#091E3A]/80 pointer-events-none"></div>
    
    <div class="relative max-w-4xl mx-auto space-y-4 sm:space-y-6 z-10">
      <div class="space-y-2">
        <p class="text-lg sm:text-xl text-[#D48D15] font-cursive">¿Qué Hacemos Mejor?</p>
        <h1 class="text-3xl sm:text-5xl md:text-6xl font-bold text-white font-heading tracking-tight leading-tight">Impulsamos el futuro de la educación</h1>
      </div>

      <!-- Social Circles -->
      <div class="flex items-center justify-center gap-3 sm:gap-4 pt-2">
        <a href="https://www.instagram.com/cedepro.ec/" target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="w-10 h-10 rounded-full border border-white/40 hover:border-white text-white flex items-center justify-center transition-all hover:scale-110 active:scale-95">
          <svg class="w-4 h-4 fill-none stroke-current" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
            <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
          </svg>
        </a>
        <a href="https://www.facebook.com/CedeproEcuador" target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="w-10 h-10 rounded-full border border-white/40 hover:border-white text-white flex items-center justify-center transition-all hover:scale-110 active:scale-95">
          <svg class="w-4 h-4 fill-current" viewBox="0 0 320 512"><path d="M279.14 288l14.22-92.66h-88.91v-60.13c0-25.35 12.42-50.06 52.24-50.06h40.42V6.26S260.43 0 225.36 0c-73.22 0-121.08 44.38-121.08 124.72v70.62H22.89V288h81.39v224h100.17V288z"/></svg>
        </a>
        <a href="https://www.linkedin.com/in/cedepro-ecuador-0200a9212/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="w-10 h-10 rounded-full border border-white/40 hover:border-white text-white flex items-center justify-center transition-all hover:scale-110 active:scale-95">
          <svg class="w-4 h-4 fill-current" viewBox="0 0 448 512"><path d="M100.28 448H7.4V148.9h92.88zM53.79 108.1C24.09 108.1 0 83.5 0 53.8a53.79 53.79 0 0 1 107.58 0c0 29.7-24.1 54.3-53.79 54.3zM447.9 448h-92.68V302.4c0-34.7-.7-79.2-48.29-79.2-48.29 0-55.69 37.7-55.69 76.7V448h-92.78V148.9h89.08v40.8h1.3c12.4-23.5 42.69-48.3 87.88-48.3 94 0 111.28 61.9 111.28 142.3V448z"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- 2. DESCUBRE CÓMO LLEVAMOS A TU INSTITUCIÓN -->
  <section class="bg-white py-14 sm:py-20 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
      
      <!-- Izquierda: Foto Fachada con Placa ISO 21001 -->
      <div class="lg:col-span-6 overflow-hidden shadow-xl border border-slate-200 bg-slate-100">
        <img 
          src="/assets/certificaciones/placa_iso.png" 
          alt="Certificación ISO 21001:2018" 
          class="w-full h-64 sm:h-80 md:h-96 lg:h-[26rem] object-cover"
          decoding="async"
        />
      </div>

      <!-- Derecha: Texto -->
      <div class="lg:col-span-6 space-y-5 sm:space-y-6 text-center lg:text-left">
        <div class="space-y-2">
          <p class="text-lg sm:text-xl text-[#091E3A] font-cursive">Descubre cómo</p>
          <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold text-[#091E3A] font-heading leading-tight">llevamos a tu institución al siguiente nivel</h2>
        </div>
        <p class="text-sm sm:text-base text-[#4a4a4a] leading-relaxed">
          En CEDEPRO, transformamos la educación con soluciones estratégicas, adaptadas a las necesidades de cada institución. A través de innovación, estructura sólida y visión integral, facilitamos procesos clave para el crecimiento y evolución académica.
        </p>
        <div>
          <a href="http://wa.me/593982867413" target="_blank" rel="noopener noreferrer" class="btn-navy w-full sm:w-auto">
            Quiero asesoría
          </a>
        </div>
      </div>

    </div>
  </section>

  <!-- 3. LISTADO DE SERVICIOS PORTAFOLIO (TARJETAS AZULES PREMIUM CON DETALLES DORADOS) -->
  <section class="relative py-16 sm:py-24 md:py-28 px-4 sm:px-6 lg:px-8 text-center bg-fixed bg-cover bg-center overflow-hidden" style="background-image: url('/assets/generales/grafico_2.png');">
    <div class="absolute inset-0 bg-[#f5f6f8]/90 pointer-events-none"></div>

    <div class="relative max-w-7xl mx-auto space-y-12 sm:space-y-16 z-10">
      
      <div class="space-y-2">
        <p class="text-lg sm:text-xl text-[#b8860b] font-cursive">Nuestros servicios</p>
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold text-[#091E3A] font-heading">Portafolio</h2>
      </div>

      <!-- Grilla de 6 Servicios -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 sm:gap-8 text-white">
        {services.map((s) => (
          <div class="relative rounded-2xl sm:rounded-3xl p-6 sm:p-10 md:p-12 text-white flex flex-col items-center justify-between space-y-6 bg-[#091E3A] border border-white/10 hover:border-white/30 shadow-xl hover:shadow-2xl hover:shadow-[#091E3A]/50 transition-all duration-300 transform hover:-translate-y-1.5 overflow-hidden group">
            
            <!-- Dark Navy Gradient Overlay with smooth color transition on hover -->
            <div class="absolute inset-0 bg-gradient-to-b from-[#091E3A] via-[#061528] to-[#091E3A] group-hover:from-[#0d2d59] group-hover:via-[#123866] group-hover:to-[#0d2d59] transition-all duration-300 pointer-events-none"></div>

            <!-- Top: Icon & Title -->
            <div class="relative z-10 space-y-4 flex flex-col items-center w-full">
              <div class="w-16 h-16 rounded-full border-2 border-white/40 bg-white/5 flex items-center justify-center text-white group-hover:border-white group-hover:bg-white/10 group-hover:scale-105 transition-all duration-300 shrink-0">
                <svg class="w-8 h-8 fill-current" viewBox={s.viewBox} set:html={s.icon} />
              </div>

              <h3 class="text-xl sm:text-2xl font-bold font-heading tracking-wide text-white transition-colors">{s.title}</h3>
              
              <p class="text-sm sm:text-base text-slate-200 leading-relaxed font-light">
                {s.description}
              </p>
            </div>

            <!-- Bottom: Beneficios -->
            <div class="relative z-10 space-y-1.5 pt-4 border-t border-white/10 w-full text-center">
              <h4 class="text-sm sm:text-base font-bold font-heading text-white tracking-wide">Beneficios:</h4>
              <p class="text-xs sm:text-sm text-slate-300 font-light leading-relaxed">
                {s.beneficios}
              </p>
            </div>

          </div>
        ))}
      </div>

      <!-- Servicio 7 Centrado: Acreditación ISO 21001:2018 -->
      <div class="max-w-2xl mx-auto text-white w-full">
        <div class="relative rounded-2xl sm:rounded-3xl p-6 sm:p-10 md:p-12 text-white flex flex-col items-center justify-between space-y-6 bg-[#091E3A] border border-white/10 hover:border-white/30 shadow-xl hover:shadow-2xl hover:shadow-[#091E3A]/50 transition-all duration-300 transform hover:-translate-y-1.5 overflow-hidden group">
          
          <!-- Dark Navy Gradient Overlay with smooth color transition on hover -->
          <div class="absolute inset-0 bg-gradient-to-b from-[#091E3A] via-[#061528] to-[#091E3A] group-hover:from-[#0d2d59] group-hover:via-[#123866] group-hover:to-[#0d2d59] transition-all duration-300 pointer-events-none"></div>

          <div class="relative z-10 space-y-4 flex flex-col items-center w-full">
            <div class="w-16 h-16 rounded-full border-2 border-white/40 bg-white/5 flex items-center justify-center text-white group-hover:border-white group-hover:bg-white/10 group-hover:scale-105 transition-all duration-300 shrink-0">
              <svg class="w-8 h-8 fill-current" viewBox={accreditationService.viewBox} set:html={accreditationService.icon} />
            </div>

            <h3 class="text-xl sm:text-2xl font-bold font-heading tracking-wide text-white transition-colors">{accreditationService.title}</h3>
            
            <p class="text-sm sm:text-base text-slate-200 leading-relaxed font-light">
              {accreditationService.description}
            </p>
          </div>

          <div class="relative z-10 space-y-1.5 pt-4 border-t border-white/10 w-full text-center">
            <h4 class="text-sm sm:text-base font-bold font-heading text-white tracking-wide">Beneficios:</h4>
            <p class="text-xs sm:text-sm text-slate-300 font-light leading-relaxed">
              {accreditationService.beneficios}
            </p>
          </div>

        </div>
      </div>

    </div>
  </section>

</Layout>
